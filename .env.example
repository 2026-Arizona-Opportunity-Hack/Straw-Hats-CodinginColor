# Copy to .env and fill in real values. .env is gitignored; this file is the
# documentation of what the app needs. Never put real keys in here.

# Supabase project (Settings > API). The anon key is safe in the browser;
# Row Level Security is what protects the data.
# Leave both empty to run the app on mock data with the demo logins.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only for /api/progress. Never use a VITE_ prefix or share with API consumers.
SUPABASE_SERVICE_ROLE_KEY=

# Enable real student curriculum after applying migration 1004 to the project.
VITE_LIVE_STUDENT_CURRICULUM=

# Staff can sign in with a username instead of an email: "admin" becomes
# admin@<this domain>. Defaults to cic.demo, the domain of the demo accounts.
VITE_STAFF_EMAIL_DOMAIN=

# Server-side only (Supabase Edge Function secrets). Never prefix with VITE_.
# OPENAI_BASE_URL=https://ai.ohack.dev/v1      # OHack AI gateway (see your team card)
# OPENAI_API_KEY=sk-your-key                   # keep the real one in .env only

# Optional, server-side only for Jev roster suggestions. Vercel can use its OIDC token instead.
AI_GATEWAY_API_KEY=
# Uses OpenRouter for Jev when set. Keep this server-side.
OPENROUTER_API_KEY=

# Curriculum converter. Use a separate, capped, server-only OpenRouter key.
OPENROUTER_CURRICULUM_API_KEY=

# Opt in to AI generation on loopback Vite with mock course data.
CIC_LOCAL_CURRICULUM=
